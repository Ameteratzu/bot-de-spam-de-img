# Dos cuentas con galerías y generaciones separadas
ALEXANDER_EMAIL=alexander@testimoniostelegram.com
ALEXANDER_PASSWORD=replace-with-a-private-value
JORGE_EMAIL=jorge@testimoniostelegram.com
JORGE_PASSWORD=replace-with-a-private-value

# Clave de AI Studio / Gemini API (solo se usa en el backend)
GEMINI_API_KEY=replace-with-a-private-value
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Cambiar en producción a un valor largo y aleatorio
SESSION_SECRET=replace-with-a-private-value
PORT=3000
APP_TIMEZONE=America/Lima

# Puerto publicado por Docker Compose y cookie segura para HTTPS
APP_PORT=3000
COOKIE_SECURE=false
