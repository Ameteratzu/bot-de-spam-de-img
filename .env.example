# Login compartido para las dos personas
LOGIN_EMAIL=equipo@example.com
# Genera una contraseña con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LOGIN_PASSWORD=replace-with-a-private-value

# Clave de AI Studio / Gemini API (solo se usa en el backend)
GEMINI_API_KEY=replace-with-a-private-value
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Cambiar en producción a un valor largo y aleatorio
SESSION_SECRET=replace-with-a-private-value
PORT=3000
APP_TIMEZONE=America/Lima
